TSYNCER_BASIC_USER=<..>
TSYNCER_BASIC_PASSWORD=<..>

# Uvicorn bind inside the process. Compose needs 0.0.0.0 so published ports work.
# scripts/local-run.sh always binds 127.0.0.1 and ignores this value.
TSYNCER_HOST=0.0.0.0
TSYNCER_PORT=7100

# Autoreload for `python -m api` (Docker CMD). Off unless set: the reloader
# restarts the server on any file change, including mid-push to Jira.
TSYNCER_RELOAD=0

# App log level for the `tsyncer` logger (stdout -> docker logs).
# peewee's own query log stays off at any level: it prints statements with
# their bound parameters, which would put the Jira API token in the log.
TSYNCER_LOG_LEVEL=INFO

# SQLite filename or relative path, resolved from the repo root (locally)
# and /opt/app (in Docker). Do not prefix with sqlite:///
TSYNCER_SQLITE_DB_PATH=tsyncer.db
